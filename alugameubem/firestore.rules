rules_version = '2';

// ===============================================================
// Assumed Data Model — Etapa 3 (MVP)
// ===============================================================
//
// Collection: usuarios
// Document ID: uid do Firebase Authentication
// Fields:
//   - nome: string
//   - email: string (igual a request.auth.token.email)
//   - cpf: string no formato 000.000.000-00
//   - telefone: string no formato da máscara do cadastro
//   - termos: map { versao, aceitoEm }
//   - locador: map { habilitado, habilitadoEm, versaoTermos, termosAceitosEm }
// Update do dono: ativação de locador ou edição de nome, telefone e atualizadoEm.
// A ativação não pode alterar os dados pessoais, e a edição pessoal não pode
// alterar locador, termos, e-mail, CPF, criadoEm nem cidade.
//   - criadoEm / atualizadoEm: timestamp (serverTimestamp)
// Contas antigas podem ter `cidade` e não ter `termos`/`locador`.
// O get do dono não valida schema para preservar login.
//
// Collection: condominios
// Document ID: determinístico (ex.: dev-jardim-das-flores)
// Fields do documento principal:
//   - nome, endereco, status, criadoEm, atualizadoEm
// get/list públicos somente se status == 'ativo'. Sem escrita pelo app.
// get() interno das regras no create de vinculos (fonte da verdade).
//
// Subcollection: condominios/{id}/privado/{documento}
// Documento previsto: dados (cnpj, contato, verificacao)
// Acesso do app: negado explicitamente. Sem wildcard recursivo.
//
// Collection: vinculos
// Document ID: {uid}_{condominioId}
// Limitação do MVP: não cobre duas unidades do mesmo usuário no mesmo
// condomínio. Se isso for necessário, o ID terá de ser revisto.
// Fields:
//   - usuarioId, condominioId, unidade { bloco, apartamento }
//   - status: 'ativo' no create desta etapa
//   - criadoEm / atualizadoEm: timestamp (serverTimestamp)
// Leitura: get e list somente quando resource.data.usuarioId == request.auth.uid.
// A query do app restringe usuarioId == uid e status == 'ativo'.
// Sem update/delete nesta etapa.
//
// Collection: anuncios
// Document ID: gerado pelo cliente na criação.
// Fields informados: titulo, descricao, categoria, valorDiaria,
//   porQueAlugar, acompanha, condicoes.
// Fields automáticos: proprietarioId, condominioId, vinculoId, nomeExibicao,
//   status ('ativo'), disponivel (true), criadoEm, atualizadoEm.
// Imagens: 1 a 3 URLs de download, gravadas na criação.
// List e get: anúncio ativo e disponível, conferindo o vínculo
// vinculos/{uid}_{resource.data.condominioId}.
// update e delete continuam fechados.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function ehDono(uid) {
      return autenticado() && request.auth.uid == uid;
    }

    function mapaExato(mapa, campos) {
      return mapa is map
        && mapa.keys().hasOnly(campos)
        && mapa.keys().hasAll(campos);
    }

    function texto(valor, min, max) {
      return valor is string
        && valor.size() >= min
        && valor.size() <= max;
    }

    // serverTimestamp() é avaliado como request.time nas rules.
    // Impede o cliente de gravar um Timestamp escolhido à mão.
    function timestampDoServidor(valor) {
      return valor == request.time;
    }

    function cpfMascarado(valor) {
      return valor is string
        && valor.matches('^[0-9]{3}\\.[0-9]{3}\\.[0-9]{3}-[0-9]{2}$');
    }

    // Máscara atual: DDD + até 11 dígitos → "(00) 00000-000" ou "(00) 00000-0000".
    function telefoneMascarado(valor) {
      return valor is string
        && valor.matches('^\\([0-9]{2}\\) [0-9]{5}-[0-9]{3,4}$');
    }

    function condominioAtivo(condominioId) {
      let caminho = /databases/$(database)/documents/condominios/$(condominioId);
      return condominioId is string
        && exists(caminho)
        && get(caminho).data.status == 'ativo';
    }

    match /usuarios/{usuarioId} {
      allow get: if ehDono(usuarioId);

      allow create: if ehDono(usuarioId) && usuarioNovoValido();

      allow update: if ehDono(usuarioId)
        && (ativacaoLocadorValida() || edicaoDadosPessoaisValida());

      function edicaoDadosPessoaisValida() {
        let depois = request.resource.data;
        return depois.diff(resource.data).affectedKeys().hasOnly(['nome', 'telefone', 'atualizadoEm'])
          && timestampDoServidor(depois.atualizadoEm)
          && texto(depois.nome, 2, 80)
          && telefoneMascarado(depois.telefone);
      }

      function ativacaoLocadorValida() {
        let antes = resource.data;
        let depois = request.resource.data;
        return depois.diff(antes).affectedKeys().hasOnly(['locador', 'atualizadoEm'])
          && timestampDoServidor(depois.atualizadoEm)
          && locadorAtivado(antes.locador, depois.locador);
      }

      function locadorAtivado(antes, depois) {
        return mapaExato(depois, [
             'habilitado', 'habilitadoEm',
             'versaoTermos', 'termosAceitosEm'
           ])
          && antes.habilitado == false
          && depois.habilitado == true
          && timestampDoServidor(depois.habilitadoEm)
          && timestampDoServidor(depois.termosAceitosEm)
          && texto(depois.versaoTermos, 1, 20);
      }

      function usuarioNovoValido() {
        let d = request.resource.data;
        return mapaExato(d, [
             'nome', 'email', 'cpf', 'telefone',
             'termos', 'locador', 'criadoEm', 'atualizadoEm'
           ])
           && texto(d.nome, 2, 80)
           && texto(d.email, 5, 120)
           && d.email == request.auth.token.email
           && cpfMascarado(d.cpf)
           && telefoneMascarado(d.telefone)
           && termosGeraisValidos(d.termos)
           && locadorInicialValido(d.locador)
           && timestampDoServidor(d.criadoEm)
           && timestampDoServidor(d.atualizadoEm);
      }

      function termosGeraisValidos(termos) {
        return mapaExato(termos, ['versao', 'aceitoEm'])
          && termos.versao == '1'
          && timestampDoServidor(termos.aceitoEm);
      }

      function locadorInicialValido(locador) {
        return mapaExato(locador, [
             'habilitado', 'habilitadoEm',
             'versaoTermos', 'termosAceitosEm'
           ])
          && locador.habilitado == false
          && locador.habilitadoEm == null
          && locador.versaoTermos == null
          && locador.termosAceitosEm == null;
      }
    }

    match /condominios/{condominioId} {
      allow get, list: if resource.data.status == 'ativo';

      match /privado/{documento} {
        allow get, list, create, update, delete: if false;
      }
    }

    match /vinculos/{vinculoId} {
      allow get, list: if autenticado()
        && resource.data.usuarioId == request.auth.uid;

      allow create: if autenticado() && vinculoNovoValido();

      function vinculoNovoValido() {
        let d = request.resource.data;
        return mapaExato(d, [
             'usuarioId', 'condominioId', 'unidade',
             'status', 'criadoEm', 'atualizadoEm'
           ])
           && d.usuarioId == request.auth.uid
           && vinculoId == request.auth.uid + '_' + d.condominioId
           && texto(d.condominioId, 1, 80)
           && condominioAtivo(d.condominioId)
           && d.status == 'ativo'
           && unidadeValida(d.unidade)
           && timestampDoServidor(d.criadoEm)
           && timestampDoServidor(d.atualizadoEm);
      }

      function unidadeValida(unidade) {
        return mapaExato(unidade, ['bloco', 'apartamento'])
          && texto(unidade.bloco, 1, 40)
          && texto(unidade.apartamento, 1, 20);
      }
    }

    match /anuncios/{anuncioId} {
      allow create: if autenticado() && anuncioNovoValido();

      allow get, list: if autenticado() && anuncioDoFeed();

      function anuncioDoFeed() {
        let condominioId = resource.data.condominioId;
        let caminho = /databases/$(database)/documents/vinculos/$(request.auth.uid + '_' + condominioId);
        return resource.data.status == 'ativo'
          && resource.data.disponivel == true
          && condominioId is string
          && exists(caminho)
          && get(caminho).data.usuarioId == request.auth.uid
          && get(caminho).data.condominioId == condominioId
          && get(caminho).data.status == 'ativo';
      }

      function anuncioNovoValido() {
        let d = request.resource.data;
        return mapaExato(d, [
             'titulo', 'descricao', 'categoria', 'valorDiaria',
             'porQueAlugar', 'acompanha', 'condicoes', 'imagens',
             'proprietarioId', 'condominioId', 'vinculoId', 'nomeExibicao',
             'status', 'disponivel', 'criadoEm', 'atualizadoEm'
           ])
          && d.proprietarioId == request.auth.uid
          && locadorHabilitado()
          && vinculoDoAnuncioConfere(d)
          && d.status == 'ativo'
          && d.disponivel == true
          && timestampDoServidor(d.criadoEm)
          && timestampDoServidor(d.atualizadoEm)
          && imagensDoAnuncio(d.imagens)
          && categoriaDeAnuncio(d.categoria)
          && d.valorDiaria is number
          && d.valorDiaria > 0
          && textoPreenchido(d.titulo, 80)
          && textoPreenchido(d.descricao, 500)
          && textoPreenchido(d.porQueAlugar, 500)
          && textoOpcional(d.acompanha, 500)
          && textoOpcional(d.condicoes, 500)
          && textoPreenchido(d.nomeExibicao, 40)
          && texto(d.condominioId, 1, 80)
          && texto(d.vinculoId, 1, 200);
      }

      function locadorHabilitado() {
        let caminho = /databases/$(database)/documents/usuarios/$(request.auth.uid);
        return exists(caminho)
          && get(caminho).data.locador.habilitado == true;
      }

      function vinculoDoAnuncioConfere(d) {
        let caminho = /databases/$(database)/documents/vinculos/$(d.vinculoId);
        return d.vinculoId == request.auth.uid + '_' + d.condominioId
          && exists(caminho)
          && get(caminho).data.usuarioId == request.auth.uid
          && get(caminho).data.condominioId == d.condominioId
          && get(caminho).data.status == 'ativo';
      }

      function imagensDoAnuncio(valor) {
        return valor is list
          && valor.size() >= 1
          && valor.size() <= 3
          && valor[0] is string
          && valor[0].size() > 0
          && (valor.size() < 2 || (valor[1] is string && valor[1].size() > 0))
          && (valor.size() < 3 || (valor[2] is string && valor[2].size() > 0));
      }

      function categoriaDeAnuncio(valor) {
        return valor in ['Casa', 'Eletrônicos', 'Esporte', 'Ferramentas'];
      }

      function textoPreenchido(valor, max) {
        return valor is string
          && valor.size() > 0
          && valor.size() <= max
          && valor.matches('.*\\S.*');
      }

      function textoOpcional(valor, max) {
        return valor is string && valor.size() <= max;
      }
    }
  }
}
